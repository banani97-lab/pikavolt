<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode with automatic signing promotes
	     this to "production" for release/TestFlight/App Store builds; keep
	     "development" here for debug/device dev builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
